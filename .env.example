# Copy to .env.local and fill in. Never commit real values.
# .env.local is gitignored; .env.example (this file) is not.

# ── Supabase ────────────────────────────────────────────────────────────────
# From the Supabase dashboard: Project Settings → API Keys.
#
# Note on naming: Supabase replaced the old `anon` / `service_role` pair with
# `publishable` / `secret` keys. The variables below use the current names.
# If you meet older tutorials, anon ≈ publishable and service_role ≈ secret.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_<...>"

# Server-only. Bypasses RLS entirely, so it is used in exactly two places:
# the retention cron (T15) and the test suite. Never import it into a client
# component, and never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY="sb_secret_<...>"

# ── Admin ───────────────────────────────────────────────────────────────────
# Comma-separated. Matching is case-insensitive and trims whitespace.
# Changing who is an admin requires a deploy, by design — there is no in-app
# path to promote an account.
ADMIN_EMAILS="you@example.com"

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Open Graph and OAuth redirect URLs are
# built from this, and LinkedIn/WhatsApp reject relative image paths (T13).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Cron (T15) ──────────────────────────────────────────────────────────────
# Bearer token guarding /api/cron/retention. Generate with:
#   openssl rand -hex 32
CRON_SECRET="<random-hex>"
